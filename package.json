{
  "name": "@qubit-ltd/common-decorator",
  "version": "3.10.9",
  "description": "A JavaScript ES7 library of common decorators",
  "author": "Haixing Hu (starfish.hu@gmail.com)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qubit-ltd/js-common-decorator.git"
  },
  "bugs": {
    "url": "https://github.com/qubit-ltd/js-common-decorator/issues"
  },
  "homepage": "https://github.com/qubit-ltd/js-common-decorator",
  "keywords": [
    "JavaScript",
    "decorator"
  ],
  "main": "dist/common-decorator.min.cjs",
  "module": "dist/common-decorator.min.mjs",
  "exports": {
    ".": {
      "require": "./dist/common-decorator.min.cjs",
      "import": "./dist/common-decorator.min.mjs"
    }
  },
  "files": [
    "dist/**/*",
    "doc/**/*",
    "LICENSE",
    "README.md",
    "README.zh_CN.md"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "rm -rvf dist doc",
    "build": "cross-env NODE_ENV=production rollup -c rollup.config.mjs",
    "build:dev": "cross-env NODE_ENV=development rollup -c rollup.config.mjs",
    "build:all": "npm run clean && npm run doc && npm run build:dev && npm run build",
    "test": "jest",
    "lint": "eslint ./src ./test",
    "doc": "jsdoc -c jsdoc.json",
    "es5": "check-es-version -e 5 -s true",
    "deploy": "npm run test && npm run build:all && npm publish --@qubit-ltd:registry='https://registry.npmjs.org/' --access public"
  },
  "browserify": {
    "transform": [
      "babelify"
    ]
  },
  "peerDependencies": {
    "@babel/runtime": "^7.28.5",
    "@qubit-ltd/clone": "^1.13.7",
    "@qubit-ltd/common-util": "^5.4.10",
    "@qubit-ltd/json": "^1.2.7",
    "@qubit-ltd/naming-style": "^1.3.13",
    "@qubit-ltd/type-detect": "^2.2.9",
    "@qubit-ltd/typeinfo": "^3.3.10",
    "@qubit-ltd/validation-rule": "^1.8.2"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/eslint-parser": "^7.28.5",
    "@babel/plugin-proposal-decorators": "^7.28.5",
    "@babel/plugin-transform-runtime": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/runtime": "^7.28.5",
    "@jest/core": "^30.1.3",
    "@qubit-ltd/clone": "^1.13.7",
    "@qubit-ltd/common-util": "^5.4.10",
    "@qubit-ltd/eslint-config": "^2.0.2",
    "@qubit-ltd/jsdoc-theme": "^1.5.3",
    "@qubit-ltd/json": "^1.2.7",
    "@qubit-ltd/naming-style": "^1.3.13",
    "@qubit-ltd/rollup-builder": "^1.8.15",
    "@qubit-ltd/type-detect": "^2.2.9",
    "@qubit-ltd/typeinfo": "^3.3.10",
    "@qubit-ltd/validation-rule": "^1.8.2",
    "@rollup/plugin-alias": "^6.0.0",
    "@rollup/plugin-babel": "^6.1.0",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@vue/compiler-dom": "^3.5.29",
    "@vue/server-renderer": "^3.5.29",
    "@vue/test-utils": "^2.4.6",
    "babel-jest": "^29.7.0",
    "check-es-version": "^1.5.1",
    "core-js": "^3.45.1",
    "cross-env": "^10.0.0",
    "email-validator": "^2.0.4",
    "eslint": "^9.35.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-vue": "^10.4.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-environment-jsdom-global": "^4.0.0",
    "jest-extended": "^6.0.0",
    "jsdoc": "^4.0.4",
    "rollup": "^4.59.0",
    "rollup-plugin-analyzer": "^4.0.0",
    "rollup-plugin-visualizer": "^6.0.5",
    "typescript": "^5.9.2",
    "vue": "^3.5.29",
    "vue-eslint-parser": "^10.2.0"
  },
  "packageManager": "yarn@4.5.0"
}
